ngx_addon_name=ngx_expr_module

if [ "$ngx_module_link" = DYNAMIC ]; then
    cat << END

$0: error: ngx_expr_module must be built statically with --add-module
because NGX_EXPR-enabled built-in directives reference its public API

END
    exit 1
fi

have=NGX_EXPR . auto/have

ngx_expr_nginx_version=`awk '$1 == "#define" && $2 == "nginx_version" {
                                      print $3
                                  }' src/core/nginx.h`

if [ -n "$ngx_expr_nginx_version" \
     -a "$ngx_expr_nginx_version" -ge 1031005 ]; then
    ngx_expr_cjson_libs=

else
    ngx_expr_cjson_libs=

    ngx_feature="cJSON library"
    ngx_feature_name="NGX_CJSON"
    ngx_feature_run=no
    ngx_feature_incs="#include <cjson/cJSON.h>"
    ngx_feature_path=
    ngx_feature_libs="-lcjson"
    ngx_feature_test="const char *end = NULL;
                      cJSON *json = cJSON_ParseWithLengthOpts(\"{}\", 2,
                                                              &end, 0);
                      if (json) cJSON_Delete(json);"
    . auto/feature

    if [ "$ngx_found" = yes ]; then
        ngx_expr_cjson_libs="$ngx_feature_libs"

    else
        cat << END

$0: warning: cJSON library not found, is_json expression operator will not be available

END
    fi
fi

ngx_expr_incs="$ngx_addon_dir/src"
ngx_expr_deps="$ngx_addon_dir/src/ngx_expr.h"

if [ "$HTTP" = YES ]; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_expr_module
    ngx_module_incs="$ngx_expr_incs"
    ngx_module_deps="$ngx_expr_deps \
                     $ngx_addon_dir/src/ngx_http_expr_module.h"
    ngx_module_srcs="$ngx_addon_dir/src/ngx_expr.c \
                     $ngx_addon_dir/src/ngx_http_expr_module.c"
    ngx_module_libs="$ngx_expr_cjson_libs"

    . auto/module
fi

if [ "$STREAM" = YES ]; then
    ngx_module_type=STREAM
    ngx_module_name=ngx_stream_expr_module
    ngx_module_incs="$ngx_expr_incs"
    ngx_module_deps="$ngx_expr_deps \
                     $ngx_addon_dir/src/ngx_stream_expr_module.h"
    ngx_module_srcs="$ngx_addon_dir/src/ngx_expr.c \
                     $ngx_addon_dir/src/ngx_stream_expr_module.c"
    ngx_module_libs="$ngx_expr_cjson_libs"

    . auto/module
fi

ngx_addon_name=ngx_condition_module

if [ "$ngx_module_link" = DYNAMIC ]; then
    cat << END

$0: error: ngx_condition_module must be built statically with --add-module
because NGX_CONDITION-enabled built-in directives reference its public API

END
    exit 1
fi

have=NGX_CONDITION . auto/have

ngx_condition_cjson_libs=

ngx_feature="cJSON library"
ngx_feature_name="NGX_CJSON"
ngx_feature_run=no
ngx_feature_incs="#include <cjson/cJSON.h>"
ngx_feature_path=
ngx_feature_libs="-lcjson"
ngx_feature_test="const char *end = NULL;
                  cJSON *json = cJSON_ParseWithLengthOpts(\"{}\", 2,
                                                          &end, 0);
                  if (json) cJSON_Delete(json);"
. auto/feature

if [ "$ngx_found" = yes ]; then
    ngx_condition_cjson_libs="$ngx_feature_libs"
else
    cat << END

$0: warning: cJSON library not found, is_json condition will not be available

END
fi

ngx_condition_incs="$ngx_addon_dir/src"
ngx_condition_deps="$ngx_addon_dir/src/ngx_condition.h"

if [ "$HTTP" = YES ]; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_condition_module
    ngx_module_incs="$ngx_condition_incs"
    ngx_module_deps="$ngx_condition_deps \
                     $ngx_addon_dir/src/ngx_http_condition_module.h"
    ngx_module_srcs="$ngx_addon_dir/src/ngx_condition.c \
                     $ngx_addon_dir/src/ngx_http_condition_module.c"
    ngx_module_libs="$ngx_condition_cjson_libs"

    . auto/module
fi

if [ "$STREAM" = YES ]; then
    ngx_module_type=STREAM
    ngx_module_name=ngx_stream_condition_module
    ngx_module_incs="$ngx_condition_incs"
    ngx_module_deps="$ngx_condition_deps \
                     $ngx_addon_dir/src/ngx_stream_condition_module.h"
    ngx_module_srcs="$ngx_addon_dir/src/ngx_condition.c \
                     $ngx_addon_dir/src/ngx_stream_condition_module.c"
    ngx_module_libs="$ngx_condition_cjson_libs"

    . auto/module
fi
